{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "start": "node --enable-source-maps artifacts/api-server/dist/index.mjs",
    "postinstall": "node scripts/render-build.mjs",
    "build": "pnpm --filter @workspace/api-server run build",
    "build:workspace": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "push": "pnpm --filter @workspace/scripts run push-to-github",
    "push:watch": "pnpm --filter @workspace/scripts run push-watch"
  },
  "private": true,
  "devDependencies": {
    "prettier": "^3.8.3",
    "typescript": "~5.9.3"
  }
}
