{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "start": "node --enable-source-maps artifacts/api-server/dist/index.mjs",
    "postinstall": "node scripts/render-build.mjs",
    "build": "pnpm --filter @workspace/api-server run build",
    "build:cloudflare": "node cloudflare/stage-assets.mjs",
    "build:pages": "pnpm run build:cloudflare",
    "build:workspace": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "preview:cloudflare": "node cloudflare/preview.mjs",
    "test:cloudflare:assets": "pnpm run build:pages && node --test cloudflare/stage-assets.test.mjs",
    "test:cloudflare:routes": "pnpm --filter @workspace/scripts exec vitest run --root=.. cloudflare/worker-routing.test.ts",
    "migrate:firebase-to-cloudflare": "node scripts/migrate-firebase-to-cloudflare.mjs",
    "audit:firebase-full": "node scripts/firebase-full-audit.mjs",
    "migrate:firebase-full": "node scripts/migrate-firebase-full.mjs",
    "push": "pnpm --filter @workspace/scripts run push-to-github",
    "push:watch": "pnpm --filter @workspace/scripts run push-watch"
  },
  "private": true,
  "devDependencies": {
    "prettier": "^3.8.3",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "workbox-build": "^7.3.0",
    "wrangler": "^4.136.3"
  }
}
