{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "push": "drizzle-kit push --config ./drizzle.config.ts",
    "push-force": "drizzle-kit push --force --config ./drizzle.config.ts",
    "migrate:d1-users": "node ./scripts/migrate-d1-users.mjs",
    "migrate:neon-schema": "node ./scripts/apply-neon-migrations.mjs",
    "migrate:neon-schema:apply": "node ./scripts/apply-neon-migrations.mjs --apply",
    "migrate:d1-operational-data": "node ./scripts/migrate-d1-operational-data.mjs",
    "migrate:d1-operational-data:apply": "node ./scripts/migrate-d1-operational-data.mjs --apply"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "drizzle-zod": "^0.8.3",
    "pg": "^8.20.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10"
  }
}
