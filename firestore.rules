rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isSuperAdmin() {
      return signedIn() && role() == 'superadmin';
    }

    function isMfiUser() {
      return signedIn() && role() in ['mfi_admin', 'loan_officer', 'loan_manager', 'loan_director'];
    }

    function sameMfiInstitution(institutionId) {
      return isMfiUser()
        && institutionId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.institutionId;
    }

    function isTimetableUser() {
      return signedIn() && role() in ['school', 'school_admin', 'headteacher', 'teacher', 'individual', 'student', 'superadmin'];
    }

    function sameSchool(institutionId) {
      return isSuperAdmin() || (isTimetableUser()
        && (institutionId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.schoolId
          || institutionId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.institutionId));
    }

    function canManageTimetable() {
      return isSuperAdmin() || (signedIn() && role() in ['school', 'school_admin', 'headteacher']);
    }

    function isClinicUser() {
      return signedIn() && role() in ['clinic_admin', 'doctor', 'nurse', 'receptionist', 'pharmacist', 'patient'];
    }

    function sameClinicInstitution(institutionId) {
      return isClinicUser()
        && institutionId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.institutionId;
    }

    function sameClinicAdminInstitution(institutionId) {
      return signedIn()
        && role() == 'clinic_admin'
        && institutionId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.institutionId;
    }

    function isFarmUser() {
      return signedIn() && role() in ['farm_admin', 'farm_manager', 'farm_worker', 'farm_director'];
    }

    function sameFarm(farmId) {
      return isFarmUser()
        && (farmId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.farmId
          || farmId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.institutionId
          || (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.farmIds != null
            && farmId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.farmIds));
    }

    function isFarmReader() {
      return isFarmUser() && (role() in ['farm_admin', 'farm_manager', 'farm_director']);
    }

    function isFarmAdmin() {
      return isSuperAdmin() || (isFarmUser() && role() == 'farm_admin');
    }

    function isFarmManager() {
      return isFarmAdmin() || (isFarmUser() && role() == 'farm_manager');
    }

    match /liveLessons/{lessonId} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn()
        && role() in ['teacher', 'school', 'superadmin'];
    }

    match /videoQuestions/{questionId} {
      allow read, create, update: if signedIn();
    }

    match /cartoon_assets/{assetId} {
      allow read: if signedIn();
      allow create, update, delete: if isSuperAdmin();
    }

    match /video_studio_projects/{projectId} {
      allow read, create, update, delete: if isSuperAdmin();
    }

    match /video_generation_queue/{queueId} {
      allow read, create, update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    match /video_library/{libraryId} {
      allow read: if signedIn();
      allow create, update, delete: if isSuperAdmin();
    }

    match /video_generation_stats/{monthId} {
      allow read, write: if isSuperAdmin();
    }

    match /twin_api_config/{configId} {
      allow read, write: if isSuperAdmin();
    }

    match /teacher_twins/{twinId} {
      allow read: if isSuperAdmin()
        || (signedIn() && resource.data.teacherId == request.auth.uid);
      allow create, update, delete: if isSuperAdmin();
    }

    match /twin_generation_jobs/{jobId} {
      allow read, create, update, delete: if isSuperAdmin();
    }

    match /video_assignments/{assignmentId} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn() && role() in ['teacher', 'superadmin', 'school'];
    }

    match /videoViews/{viewId} {
      allow create, update: if signedIn();
      allow read: if isSuperAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
    }

    match /bug_reports/{reportId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isSuperAdmin();
    }

    match /feature_requests/{requestId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isSuperAdmin();
    }

    match /institutions/{institutionId} {
      allow read: if signedIn() && (isSuperAdmin()
        || resource.data.adminUid == request.auth.uid
        || resource.data.createdBy == request.auth.uid
        || sameClinicAdminInstitution(institutionId));
      allow create, delete: if isSuperAdmin();
      allow update: if isSuperAdmin()
        || sameClinicAdminInstitution(institutionId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'tagline', 'phone', 'email', 'emergencyContact', 'slotDuration',
            'operatingHours', 'prescriptionFormat', 'insuranceProviders',
            'notificationPreferences', 'updatedAt', 'updatedBy'
          ]);
    }

    match /users/{userId} {
      allow read: if isSuperAdmin() || userId == request.auth.uid
        || sameClinicInstitution(resource.data.institutionId);
      allow update: if isSuperAdmin()
        || sameClinicAdminInstitution(resource.data.institutionId)
          && request.resource.data.institutionId == resource.data.institutionId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'role', 'updatedAt', 'updatedBy'
          ]);
    }

    // Server-side AI usage records are append-only and scoped to their owner.
    match /user_usage/{usageId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'userId', 'timestamp', 'count', 'blocked', 'source'
        ]);
      allow read: if isSuperAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow update, delete: if false;
    }

    match /institution_branding/{brandingId} {
      allow read: if signedIn() && (isSuperAdmin()
        || resource.data.institutionId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.institutionId
        || resource.data.institutionId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.schoolId);
      allow create, update, delete: if isSuperAdmin();
    }

    // Command Center management collections are explicitly superadmin-scoped.
    match /transactions/{transactionId} {
      allow read, write: if isSuperAdmin();
    }
    match /subscriptions/{subscriptionId} {
      allow read, write: if isSuperAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
    }
    match /ca_exports/{exportId} {
      allow read, write: if isSuperAdmin();
    }
    match /cpd_certificates/{certificateId} {
      allow read, write: if isSuperAdmin();
    }
    match /audit_logs/{auditId} {
      allow read, create: if isSuperAdmin();
    }
    match /failed_logins/{failedLoginId} {
      allow read: if isSuperAdmin();
      allow create: if true;
    }
    match /active_sessions/{sessionId} {
      allow read, write: if isSuperAdmin();
    }
    match /data_subject_requests/{requestId} {
      allow read, write: if isSuperAdmin();
    }
    match /settings/{settingId} {
      allow read, write: if signedIn() && (isSuperAdmin() || settingId == 'about');
    }

    // Task 12 payment records: server webhooks use the service account; clients
    // can only see their own records or their institution scope.
    match /payment_transactions/{id} {
      allow read: if isSuperAdmin() || (signedIn() && (resource.data.clientId == request.auth.uid || resource.data.payerId == request.auth.uid))
        || (signedIn() && resource.data.institutionId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.institutionId);
      allow create: if isSuperAdmin() || (signedIn() && (request.resource.data.clientId == request.auth.uid || request.resource.data.payerId == request.auth.uid));
      allow update, delete: if isSuperAdmin();
    }
    match /institution_beneficiaries/{id} {
      allow read, write: if isSuperAdmin() || (signedIn() && resource.data.institutionId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.institutionId);
    }
    match /payment_disbursements/{id} {
      allow read: if isSuperAdmin() || (signedIn() && resource.data.institutionId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.institutionId);
      allow create, update, delete: if isSuperAdmin();
    }
    match /payment_notifications/{id} {
      allow read: if isSuperAdmin() || (signedIn() && (resource.data.userId == request.auth.uid || resource.data.recipientId == request.auth.uid));
      allow create, update, delete: if isSuperAdmin();
    }
    match /payment_settings/{id} {
      allow read, write: if isSuperAdmin();
    }
    match /yo_webhook_logs/{id} {
      allow read: if isSuperAdmin();
      allow create: if isSuperAdmin();
      allow update, delete: if false;
    }
    match /payment_audit_log/{id} {
      allow read: if isSuperAdmin();
      allow create: if isSuperAdmin();
      allow update, delete: if false;
    }
    match /credit_notes/{id} {
      allow read: if isSuperAdmin() || (signedIn() && resource.data.clientId == request.auth.uid);
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin()
        || (signedIn() && resource.data.clientId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedAmount', 'balanceRemaining', 'status', 'updatedAt']));
      allow delete: if false;
    }
    match /sector_balances/{id} {
      allow read: if isSuperAdmin() || (signedIn() && (resource.data.clientId == request.auth.uid
        || resource.data.institutionId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.institutionId));
      allow write: if isSuperAdmin();
    }
    match /payment_reminders/{id} {
      allow read: if isSuperAdmin() || (signedIn() && resource.data.clientId == request.auth.uid);
      allow create, update: if isSuperAdmin();
      allow delete: if false;
    }
    match /payment_reports_cache/{id} {
      allow read, create: if isSuperAdmin();
      allow update, delete: if false;
    }
    match /payment_reconciliations/{id} {
      allow read, create, update: if isSuperAdmin();
      allow delete: if false;
    }
    match /payment_daily_reconciliations/{id} {
      allow read, create: if isSuperAdmin();
      allow update, delete: if false;
    }
    match /payment_monthly_archives/{id} {
      allow read, create: if isSuperAdmin();
      allow update, delete: if false;
    }
    match /mfi_collateral_types/{typeId} {
      allow read: if signedIn();
      allow write: if isSuperAdmin();
    }
    match /mfi_customers/{customerId} {
      allow read: if isSuperAdmin() || sameMfiInstitution(resource.data.institutionId)
        || (signedIn() && role() == 'borrower' && (resource.data.customerId == request.auth.uid || customerId == request.auth.uid));
      allow create: if isSuperAdmin() || sameMfiInstitution(request.resource.data.institutionId) && role() in ['mfi_admin', 'loan_officer'];
      allow update: if isSuperAdmin()
        || sameMfiInstitution(resource.data.institutionId) && role() in ['mfi_admin', 'loan_officer']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['firstName', 'lastName', 'phone', 'email', 'nationalId', 'dateOfBirth', 'gender', 'occupation', 'monthlyIncome', 'businessName', 'businessAddress', 'physicalAddress', 'branchId', 'branchName', 'maritalStatus', 'spouseName', 'spousePhone', 'spouseOccupation', 'spouseNationalId', 'spouseConsent', 'nextOfKinName', 'nextOfKinPhone', 'nextOfKinRelationship', 'nextOfKinAddress', 'guarantors', 'photoPath', 'nationalIdFrontPath', 'nationalIdBackPath', 'updatedAt', 'a0MigratedAt'])
        || sameMfiInstitution(resource.data.institutionId) && role() == 'loan_director'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'blacklistReason', 'blacklistedAt', 'blacklistRemovedAt', 'blacklistRemovedBy']);
      allow delete: if isSuperAdmin() || sameMfiInstitution(resource.data.institutionId) && role() == 'mfi_admin';
    }
    match /mfi_collateral/{collateralId} {
      allow read: if isSuperAdmin() || sameMfiInstitution(resource.data.institutionId)
        || (signedIn() && role() == 'borrower' && resource.data.customerId == request.auth.uid);
      allow create: if isSuperAdmin() || sameMfiInstitution(request.resource.data.institutionId) && role() in ['mfi_admin', 'loan_officer'];
      allow update: if isSuperAdmin()
        || sameMfiInstitution(resource.data.institutionId) && role() in ['mfi_admin', 'loan_officer', 'loan_manager']
        || sameMfiInstitution(resource.data.institutionId) && role() == 'loan_director'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['duplicateCleared', 'duplicateClearedAt', 'duplicateClearedBy']);
      allow delete: if isSuperAdmin() || sameMfiInstitution(resource.data.institutionId) && role() == 'mfi_admin';
    }
    match /mfi_collateral_scoring/{scoringId} {
      allow read: if isSuperAdmin() || sameMfiInstitution(resource.data.institutionId);
      allow create: if isSuperAdmin() || sameMfiInstitution(request.resource.data.institutionId) && role() in ['mfi_admin', 'loan_officer'];
      allow update: if isSuperAdmin() || sameMfiInstitution(resource.data.institutionId) && role() in ['mfi_admin', 'loan_manager'];
      allow delete: if isSuperAdmin() || sameMfiInstitution(resource.data.institutionId) && role() == 'mfi_admin';
    }
    match /mfi_collateral_documents/{documentId} {
      allow read: if isSuperAdmin() || sameMfiInstitution(resource.data.institutionId);
      allow create: if isSuperAdmin() || sameMfiInstitution(request.resource.data.institutionId) && role() in ['mfi_admin', 'loan_officer', 'loan_manager'];
      allow update, delete: if isSuperAdmin() || sameMfiInstitution(resource.data.institutionId) && role() in ['mfi_admin', 'loan_officer', 'loan_manager'];
    }
    match /mfi_branches/{branchId} {
      allow read: if isSuperAdmin() || sameMfiInstitution(resource.data.institutionId);
      allow create: if isSuperAdmin() || sameMfiInstitution(request.resource.data.institutionId) && role() == 'mfi_admin';
      allow update: if isSuperAdmin() || sameMfiInstitution(resource.data.institutionId) && role() == 'mfi_admin';
      allow delete: if isSuperAdmin() || sameMfiInstitution(resource.data.institutionId) && role() == 'mfi_admin';
    }
    match /mfi_collateral_verification/{verificationId} {
      allow read: if isSuperAdmin() || sameMfiInstitution(resource.data.institutionId);
      allow create: if isSuperAdmin() || sameMfiInstitution(request.resource.data.institutionId) && role() in ['mfi_admin', 'loan_manager'];
      allow update: if isSuperAdmin()
        || sameMfiInstitution(resource.data.institutionId)
          && (role() in ['mfi_admin', 'loan_manager'] || resource.data.assignedToId == request.auth.uid);
      allow delete: if isSuperAdmin();
    }
    match /mfi_collateral_decisions/{decisionId} {
      allow read: if isSuperAdmin() || sameMfiInstitution(resource.data.institutionId);
      allow create: if isSuperAdmin() || sameMfiInstitution(request.resource.data.institutionId) && role() in ['mfi_admin', 'loan_manager'];
      allow update, delete: if isSuperAdmin();
    }
    match /mfi_valuers/{valuerId} {
      allow read: if isSuperAdmin() || sameMfiInstitution(resource.data.institutionId);
      allow create, update, delete: if isSuperAdmin() || sameMfiInstitution(request.resource.data.institutionId) && role() == 'mfi_admin';
    }
    match /mfi_legal_officers/{officerId} {
      allow read: if isSuperAdmin() || sameMfiInstitution(resource.data.institutionId);
      allow create, update, delete: if isSuperAdmin() || sameMfiInstitution(request.resource.data.institutionId) && role() == 'mfi_admin';
    }
    match /mfi_receipts/{receiptId} {
      allow read: if isSuperAdmin() || sameMfiInstitution(resource.data.institutionId)
        || (signedIn() && role() == 'borrower' && resource.data.customerId == request.auth.uid);
      allow create: if isSuperAdmin() || sameMfiInstitution(request.resource.data.institutionId)
        && role() in ['mfi_admin', 'loan_manager', 'loan_director'];
      allow update, delete: if isSuperAdmin() || sameMfiInstitution(resource.data.institutionId) && role() == 'mfi_admin';
    }
    match /mfi_loan_products/{productId} {
      allow read: if isSuperAdmin() || sameMfiInstitution(resource.data.institutionId);
      allow create, update: if isSuperAdmin() || sameMfiInstitution(request.resource.data.institutionId) && role() == 'mfi_admin';
      allow delete: if isSuperAdmin();
    }
    match /microfinance_loans/{loanId} {
      allow read: if isSuperAdmin() || sameMfiInstitution(resource.data.institutionId)
        || (signedIn() && role() == 'borrower' && resource.data.customerId == request.auth.uid);
      allow create: if isSuperAdmin() || sameMfiInstitution(request.resource.data.institutionId) && role() in ['mfi_admin', 'loan_officer'];
      allow update: if isSuperAdmin()
        || sameMfiInstitution(resource.data.institutionId) && role() in ['mfi_admin', 'loan_manager', 'loan_director']
        || sameMfiInstitution(resource.data.institutionId) && role() == 'loan_officer'
          && resource.data.status in ['draft', 'submitted'];
      allow delete: if false;
    }
    match /mfi_loan_repayment_schedule/{installmentId} {
      allow read: if isSuperAdmin() || sameMfiInstitution(resource.data.institutionId)
        || (signedIn() && role() == 'borrower' && resource.data.customerId == request.auth.uid);
      allow create: if isSuperAdmin() || sameMfiInstitution(request.resource.data.institutionId) && role() in ['mfi_admin', 'loan_manager', 'loan_director'];
      allow update: if isSuperAdmin() || sameMfiInstitution(resource.data.institutionId) && role() in ['mfi_admin', 'loan_manager', 'loan_officer', 'loan_director'];
      allow delete: if false;
    }
    match /mfi_loan_payments/{paymentId} {
      allow read: if isSuperAdmin() || sameMfiInstitution(resource.data.institutionId)
        || (signedIn() && role() == 'borrower' && resource.data.customerId == request.auth.uid);
      allow create: if isSuperAdmin() || sameMfiInstitution(request.resource.data.institutionId) && role() in ['mfi_admin', 'loan_manager', 'loan_officer', 'loan_director'];
      allow update, delete: if false;
    }
    match /mfi_loan_approvals/{approvalId} {
      allow read: if isSuperAdmin() || sameMfiInstitution(resource.data.institutionId);
      allow create: if isSuperAdmin() || sameMfiInstitution(request.resource.data.institutionId) && role() in ['mfi_admin', 'loan_manager', 'loan_officer', 'loan_director'];
      allow update, delete: if false;
    }
    match /mfi_loan_documents/{documentId} {
      allow read: if isSuperAdmin() || sameMfiInstitution(resource.data.institutionId);
      allow create: if isSuperAdmin() || sameMfiInstitution(request.resource.data.institutionId) && role() in ['mfi_admin', 'loan_officer', 'loan_manager', 'loan_director'];
      allow update, delete: if isSuperAdmin() || sameMfiInstitution(resource.data.institutionId) && role() == 'mfi_admin';
    }
    match /mfi_loan_audit/{auditId} {
      allow read: if isSuperAdmin() || sameMfiInstitution(resource.data.institutionId);
      allow create: if isSuperAdmin() || sameMfiInstitution(request.resource.data.institutionId) && role() in ['mfi_admin', 'loan_officer', 'loan_manager', 'loan_director'];
      allow update, delete: if false;
    }
    match /mfi_loan_installment_applications/{applicationId} {
      allow read: if isSuperAdmin() || sameMfiInstitution(resource.data.institutionId)
        || (signedIn() && role() == 'borrower' && resource.data.customerId == request.auth.uid);
      allow create: if isSuperAdmin() || sameMfiInstitution(request.resource.data.institutionId) && role() in ['mfi_admin', 'loan_officer', 'loan_manager', 'loan_director'];
      allow update, delete: if false;
    }
    match /mfi_loan_overdue_log/{overdueId} {
      allow read: if isSuperAdmin() || sameMfiInstitution(resource.data.institutionId);
      allow create: if isSuperAdmin() || sameMfiInstitution(request.resource.data.institutionId) && role() in ['mfi_admin', 'loan_officer', 'loan_manager', 'loan_director'];
      allow update: if isSuperAdmin() || sameMfiInstitution(resource.data.institutionId) && role() in ['mfi_admin', 'loan_officer', 'loan_manager', 'loan_director'];
      allow delete: if false;
    }
    match /mfi_credit_notes/{creditNoteId} {
      allow read: if isSuperAdmin() || sameMfiInstitution(resource.data.institutionId)
        || (signedIn() && role() == 'borrower' && resource.data.customerId == request.auth.uid);
      allow create: if isSuperAdmin() || sameMfiInstitution(request.resource.data.institutionId) && role() in ['mfi_admin', 'loan_manager', 'loan_director'];
      allow update: if isSuperAdmin() || sameMfiInstitution(resource.data.institutionId) && role() in ['mfi_admin', 'loan_manager', 'loan_director'];
      allow delete: if false;
    }
    match /mfi_loan_restructures/{restructureId} {
      allow read: if isSuperAdmin() || sameMfiInstitution(resource.data.institutionId)
        || (signedIn() && role() == 'borrower' && resource.data.customerId == request.auth.uid);
      allow create: if isSuperAdmin() || sameMfiInstitution(request.resource.data.institutionId) && role() in ['mfi_admin', 'loan_officer', 'loan_manager', 'loan_director'];
      allow update: if isSuperAdmin() || sameMfiInstitution(resource.data.institutionId) && role() in ['mfi_admin', 'loan_manager', 'loan_director'];
      allow delete: if false;
    }
    match /mfi_loan_writeoffs/{writeoffId} {
      allow read: if isSuperAdmin() || sameMfiInstitution(resource.data.institutionId);
      allow create: if isSuperAdmin() || sameMfiInstitution(request.resource.data.institutionId) && role() in ['mfi_admin', 'loan_officer', 'loan_manager'];
      allow update: if isSuperAdmin() || sameMfiInstitution(resource.data.institutionId) && role() in ['mfi_admin', 'loan_director'];
      allow delete: if false;
    }
    match /mfi_late_fee_config/{configId} {
      allow read: if isSuperAdmin() || sameMfiInstitution(resource.data.institutionId);
      allow create, update: if isSuperAdmin() || sameMfiInstitution(request.resource.data.institutionId) && role() == 'mfi_admin';
      allow delete: if false;
    }
    match /mfi_credit_note_refund_requests/{requestId} {
      allow read: if isSuperAdmin() || sameMfiInstitution(resource.data.institutionId)
        || (signedIn() && role() == 'borrower' && resource.data.customerId == request.auth.uid);
      allow create: if isSuperAdmin() || sameMfiInstitution(request.resource.data.institutionId) && role() == 'borrower'
        && request.resource.data.customerId == request.auth.uid;
      allow update: if isSuperAdmin() || sameMfiInstitution(resource.data.institutionId) && role() in ['mfi_admin', 'loan_director'];
      allow delete: if false;
    }

    // Clinic records are institution-scoped. Reception can manage demographics
    // and scheduling, but cannot read visits or prescriptions.
    match /clinic_patients/{patientId} {
      allow read: if isSuperAdmin() || sameClinicInstitution(resource.data.institutionId);
      allow create: if isSuperAdmin() || sameClinicInstitution(request.resource.data.institutionId) && role() in ['clinic_admin', 'receptionist'];
      allow update: if isSuperAdmin() || sameClinicInstitution(resource.data.institutionId) && role() in ['clinic_admin', 'receptionist'];
      allow delete: if isSuperAdmin() || sameClinicInstitution(resource.data.institutionId) && role() == 'clinic_admin';
    }
    match /clinic_appointments/{appointmentId} {
      allow read: if isSuperAdmin() || sameClinicInstitution(resource.data.institutionId)
        || (signedIn() && role() == 'patient' && resource.data.patientId == request.auth.uid);
      allow create: if isSuperAdmin() || sameClinicInstitution(request.resource.data.institutionId) && role() in ['clinic_admin', 'receptionist', 'doctor', 'patient'];
      allow update: if isSuperAdmin() || sameClinicInstitution(resource.data.institutionId) && role() in ['clinic_admin', 'receptionist', 'doctor', 'nurse']
        || (signedIn() && role() == 'patient' && resource.data.patientId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']));
      allow delete: if isSuperAdmin() || sameClinicInstitution(resource.data.institutionId) && role() in ['clinic_admin', 'receptionist'];
    }
    match /clinic_visits/{visitId} {
      allow read: if isSuperAdmin() || sameClinicInstitution(resource.data.institutionId)
        || (signedIn() && role() == 'patient' && resource.data.patientId == request.auth.uid);
      allow create: if isSuperAdmin() || sameClinicInstitution(request.resource.data.institutionId) && role() in ['clinic_admin', 'doctor', 'nurse'];
      allow update: if isSuperAdmin() || sameClinicInstitution(resource.data.institutionId) && role() in ['clinic_admin', 'doctor', 'nurse'];
      allow delete: if isSuperAdmin() || sameClinicInstitution(resource.data.institutionId) && role() == 'clinic_admin';
    }
    match /clinic_prescriptions/{prescriptionId} {
      allow read: if isSuperAdmin() || sameClinicInstitution(resource.data.institutionId)
        || (signedIn() && role() == 'patient' && resource.data.patientId == request.auth.uid);
      allow create: if isSuperAdmin() || sameClinicInstitution(request.resource.data.institutionId) && role() in ['clinic_admin', 'doctor'];
      allow update: if isSuperAdmin() || sameClinicInstitution(resource.data.institutionId) && role() in ['clinic_admin', 'doctor', 'pharmacist'];
      allow delete: if isSuperAdmin() || sameClinicInstitution(resource.data.institutionId) && role() == 'clinic_admin';
    }
    match /clinic_services/{serviceId} {
      allow read: if isSuperAdmin() || sameClinicInstitution(resource.data.institutionId);
      allow write: if isSuperAdmin() || sameClinicInstitution(request.resource.data.institutionId) && role() == 'clinic_admin';
    }
    match /clinic_branches/{branchId} {
      allow read: if isSuperAdmin() || sameClinicInstitution(resource.data.institutionId);
      allow write: if isSuperAdmin() || sameClinicInstitution(request.resource.data.institutionId) && role() == 'clinic_admin';
    }
    match /clinic_pharmacy_inventory/{itemId} {
      allow read: if isSuperAdmin() || sameClinicInstitution(resource.data.institutionId);
      allow create: if isSuperAdmin() || sameClinicInstitution(request.resource.data.institutionId) && role() in ['clinic_admin', 'pharmacist'];
      allow update: if isSuperAdmin() || sameClinicInstitution(resource.data.institutionId) && role() in ['clinic_admin', 'pharmacist'];
      allow delete: if false;
    }
    match /clinic_product_scans/{scanId} {
      allow read: if isSuperAdmin() || sameClinicInstitution(resource.data.institutionId);
      allow create: if isSuperAdmin() || sameClinicInstitution(request.resource.data.institutionId) && role() in ['clinic_admin', 'pharmacist'];
      allow update, delete: if false;
    }
    match /clinic_billing/{billId} {
      allow read: if isSuperAdmin() || sameClinicInstitution(resource.data.institutionId)
        || (signedIn() && role() == 'patient' && resource.data.patientId == request.auth.uid);
      allow create: if isSuperAdmin() || sameClinicInstitution(request.resource.data.institutionId) && role() in ['clinic_admin', 'receptionist', 'pharmacist', 'doctor'];
      allow update: if isSuperAdmin() || sameClinicInstitution(resource.data.institutionId) && role() in ['clinic_admin', 'receptionist', 'pharmacist']
        && (resource.data.status != 'paid' || request.resource.data.status == 'reversed');
      allow delete: if false;
    }
    match /clinic_payments/{paymentId} {
      allow read: if isSuperAdmin() || sameClinicInstitution(resource.data.institutionId)
        || (signedIn() && role() == 'patient' && resource.data.patientId == request.auth.uid);
      allow create: if isSuperAdmin() || sameClinicInstitution(request.resource.data.institutionId) && role() in ['clinic_admin', 'receptionist', 'pharmacist'];
      allow update, delete: if false;
    }
    match /clinic_insurance_claims/{claimId} {
      allow read: if isSuperAdmin() || sameClinicInstitution(resource.data.institutionId)
        || (signedIn() && role() == 'patient' && resource.data.patientId == request.auth.uid);
      allow create: if isSuperAdmin() || sameClinicInstitution(request.resource.data.institutionId) && role() in ['clinic_admin', 'receptionist', 'pharmacist'];
      allow update: if isSuperAdmin() || sameClinicInstitution(resource.data.institutionId) && role() in ['clinic_admin', 'receptionist', 'pharmacist'];
      allow delete: if false;
    }
    match /clinic_report_templates/{templateId} {
      allow read: if isSuperAdmin() || sameClinicAdminInstitution(resource.data.institutionId);
      allow create: if isSuperAdmin() || sameClinicAdminInstitution(request.resource.data.institutionId);
      allow update, delete: if isSuperAdmin() || sameClinicAdminInstitution(resource.data.institutionId);
    }
    match /clinic_access_audit/{auditId} {
      allow read: if isSuperAdmin() || sameClinicAdminInstitution(resource.data.institutionId);
      allow create: if isSuperAdmin() || sameClinicInstitution(request.resource.data.institutionId);
      allow update, delete: if false;
    }
    match /clinic_communications/{communicationId} {
      allow read: if isSuperAdmin() || sameClinicAdminInstitution(resource.data.institutionId);
      allow create: if isSuperAdmin() || sameClinicAdminInstitution(request.resource.data.institutionId);
      allow update, delete: if false;
    }

    // Task 13 farm records are scoped to the user's farm. Worker face data is
    // only readable by farm administrators and managers.
    match /farms/{farmId} {
      allow read: if isSuperAdmin() || sameFarm(farmId) || (signedIn() && resource.data.institutionId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.institutionId);
      allow create: if isSuperAdmin() || (signedIn() && role() == 'farm_admin' && request.resource.data.institutionId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.institutionId);
      allow update: if isFarmAdmin() && (isSuperAdmin() || sameFarm(farmId));
      allow delete: if isSuperAdmin();
    }
    match /farm_animal_types/{typeId} {
      allow read: if signedIn();
      allow write: if isSuperAdmin();
    }
    match /farm_workers/{workerId} {
      allow read: if (isFarmReader() && sameFarm(resource.data.farmId))
        || signedIn() && resource.data.userId == request.auth.uid;
      allow create: if isFarmAdmin() && sameFarm(request.resource.data.farmId);
      allow update: if isFarmAdmin() && sameFarm(resource.data.farmId);
      allow delete: if isFarmAdmin() && sameFarm(resource.data.farmId);
    }
    match /farm_cameras/{cameraId} {
      allow read: if isFarmReader() && sameFarm(resource.data.farmId);
      allow create, delete: if isFarmAdmin() && sameFarm(request.resource.data.farmId);
      allow update: if isFarmAdmin() && sameFarm(resource.data.farmId)
        || isFarmManager() && sameFarm(resource.data.farmId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastHeartbeat', 'updatedAt', 'lastDetectionAt', 'isConnected']);
    }
    match /farm_animal_movements/{movementId} {
      allow read: if isFarmReader() && sameFarm(resource.data.farmId);
      allow create: if isFarmManager() && sameFarm(request.resource.data.farmId);
      allow update: if isFarmManager() && sameFarm(resource.data.farmId);
      allow delete: if isFarmAdmin() && sameFarm(resource.data.farmId);
    }
    match /farm_daily_summaries/{summaryId} {
      allow read: if isFarmReader() && sameFarm(resource.data.farmId);
      allow create, update: if isFarmManager() && sameFarm(request.resource.data.farmId);
      allow delete: if isFarmAdmin() && sameFarm(resource.data.farmId);
    }
    match /farm_worker_attendance/{attendanceId} {
      allow read: if isFarmReader() && sameFarm(resource.data.farmId)
        || signedIn() && resource.data.userId == request.auth.uid;
      allow create: if isFarmUser() && sameFarm(request.resource.data.farmId)
        && (role() != 'farm_worker' || request.resource.data.userId == request.auth.uid);
      allow update: if isFarmManager() && sameFarm(resource.data.farmId);
      allow delete: if isFarmAdmin() && sameFarm(resource.data.farmId);
    }
    match /farm_egg_collections/{collectionId} {
      allow read: if (isFarmReader() && sameFarm(resource.data.farmId))
        || signedIn() && resource.data.collectedBy == request.auth.uid;
      allow create: if isFarmUser() && sameFarm(request.resource.data.farmId)
        && (role() != 'farm_worker' || request.resource.data.collectedBy == request.auth.uid);
      allow update: if isFarmManager() && sameFarm(resource.data.farmId);
      allow delete: if isFarmAdmin() && sameFarm(resource.data.farmId);
    }
    match /farm_inventory/{itemId} {
      allow read: if isFarmReader() && sameFarm(resource.data.farmId);
      allow create: if isFarmAdmin() && sameFarm(request.resource.data.farmId)
        && request.resource.data.quantityInStock >= 0;
      allow update: if isFarmManager() && sameFarm(resource.data.farmId)
        && request.resource.data.quantityInStock >= 0;
      allow delete: if false;
    }
    match /farm_feed_consumption/{consumptionId} {
      allow read: if (isFarmReader() && sameFarm(resource.data.farmId))
        || signedIn() && resource.data.fedBy == request.auth.uid;
      allow create: if isFarmUser() && sameFarm(request.resource.data.farmId)
        && (role() != 'farm_worker' || request.resource.data.fedBy == request.auth.uid);
      allow update, delete: if false;
    }
    match /farm_produce/{produceId} {
      allow read: if isFarmReader() && sameFarm(resource.data.farmId);
      allow create: if isFarmManager() && sameFarm(request.resource.data.farmId);
      // Produce records are append-only in the current UI; corrections use a
      // new audited record rather than mutating historical financial data.
      allow update: if false;
      allow delete: if false;
    }
    match /farm_sales/{saleId} {
      allow read: if isFarmReader() && sameFarm(resource.data.farmId);
      allow create: if isFarmManager() && sameFarm(request.resource.data.farmId)
        && request.resource.data.totalAmount >= 0
        && request.resource.data.amountPaid >= 0
        && request.resource.data.amountPaid <= request.resource.data.totalAmount;
      allow update, delete: if false;
    }
    match /farm_expenses/{expenseId} {
      allow read: if isFarmReader() && sameFarm(resource.data.farmId);
      allow create: if isFarmManager() && sameFarm(request.resource.data.farmId)
        && request.resource.data.amount >= 0;
      // Expense records are append-only so historical costs cannot be changed.
      allow update: if false;
      allow delete: if false;
    }
    match /farm_report_templates/{templateId} {
      allow read: if isFarmReader() && sameFarm(resource.data.farmId);
      allow create: if isFarmManager() && sameFarm(request.resource.data.farmId);
      allow update: if isFarmManager() && sameFarm(resource.data.farmId);
      allow delete: if isFarmAdmin() && sameFarm(resource.data.farmId);
    }
    match /farm_lost_animals/{lostAnimalId} {
      allow read: if isFarmReader() && sameFarm(resource.data.farmId);
      allow create, update: if isFarmManager() && sameFarm(request.resource.data.farmId);
      allow delete: if isFarmAdmin() && sameFarm(resource.data.farmId);
    }

    // Timetable records are explicitly scoped to the user's school. They are
    // excluded from the authenticated catch-all below so unrelated signed-in
    // accounts cannot read or mutate another school's schedule.
    match /school_timetable_config/{configId} {
      allow read: if sameSchool(resource.data.institutionId);
      allow create, update: if canManageTimetable() && sameSchool(request.resource.data.institutionId);
      allow delete: if canManageTimetable() && sameSchool(resource.data.institutionId);
    }
    match /school_classes/{classId} {
      allow read: if sameSchool(resource.data.institutionId);
      allow create, update: if canManageTimetable() && sameSchool(request.resource.data.institutionId);
      allow delete: if canManageTimetable() && sameSchool(resource.data.institutionId);
    }
    match /school_subjects/{subjectId} {
      allow read: if sameSchool(resource.data.institutionId);
      allow create, update: if canManageTimetable() && sameSchool(request.resource.data.institutionId);
      allow delete: if canManageTimetable() && sameSchool(resource.data.institutionId);
    }
    match /school_teacher_assignments/{assignmentId} {
      allow read: if sameSchool(resource.data.institutionId);
      allow create, update: if canManageTimetable() && sameSchool(request.resource.data.institutionId);
      allow delete: if canManageTimetable() && sameSchool(resource.data.institutionId);
    }
    match /timetable_teacher_duty/{dutyId} {
      allow read: if sameSchool(resource.data.institutionId);
      allow create, update: if canManageTimetable() && sameSchool(request.resource.data.institutionId);
      allow delete: if canManageTimetable() && sameSchool(resource.data.institutionId);
    }
    match /school_combined_periods/{periodId} {
      allow read: if sameSchool(resource.data.institutionId);
      allow create, update: if canManageTimetable() && sameSchool(request.resource.data.institutionId);
      allow delete: if canManageTimetable() && sameSchool(resource.data.institutionId);
    }
    match /school_timetable_expected_outcomes/{outcomeId} {
      allow read: if sameSchool(resource.data.institutionId);
      allow create, update: if canManageTimetable() && sameSchool(request.resource.data.institutionId);
      allow delete: if canManageTimetable() && sameSchool(resource.data.institutionId);
    }
    match /school_timetables/{timetableId} {
      allow read: if sameSchool(resource.data.institutionId);
      allow create, update: if canManageTimetable() && sameSchool(request.resource.data.institutionId);
      allow delete: if canManageTimetable() && sameSchool(resource.data.institutionId);
    }

    // Preserve access for the existing authenticated application collections.
    match /{document=**} {
      allow read, write: if signedIn() && !document.matches('^(cartoon_assets|video_studio_projects|video_generation_queue|video_library|video_generation_stats|twin_api_config|teacher_twins|twin_generation_jobs|video_assignments|videoViews|audit_logs|failed_logins|active_sessions|data_subject_requests|settings/(platform|security|pdpo|backup_status)|mfi_collateral_types|mfi_customers|mfi_collateral|mfi_collateral_scoring|mfi_collateral_documents|mfi_branches|mfi_collateral_verification|mfi_collateral_decisions|mfi_valuers|mfi_legal_officers|mfi_receipts|mfi_loan_products|microfinance_loans|mfi_loan_repayment_schedule|mfi_loan_payments|mfi_loan_approvals|mfi_loan_documents|mfi_loan_audit|mfi_loan_installment_applications|mfi_loan_overdue_log|mfi_credit_notes|mfi_loan_restructures|mfi_loan_writeoffs|mfi_late_fee_config|mfi_credit_note_refund_requests|clinic_patients|clinic_appointments|clinic_visits|clinic_prescriptions|clinic_services|clinic_branches|clinic_pharmacy_inventory|clinic_product_scans|clinic_billing|clinic_payments|clinic_insurance_claims|clinic_report_templates|clinic_access_audit|clinic_communications|school_timetable_config|school_classes|school_subjects|school_teacher_assignments|timetable_teacher_duty|school_combined_periods|school_timetable_expected_outcomes|school_timetables)(/.*)?$');
    }
  }
}